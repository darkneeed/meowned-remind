# Auto-detect text files and normalize line endings to LF on commit
* text=auto

# Source code and config files
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.pro text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Unix shell scripts must strictly be LF
gradlew text eol=lf

# Windows batch scripts must strictly be CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.png binary
*.webp binary
*.keystore binary
*.jks binary
